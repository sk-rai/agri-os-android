<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission tools:node="removeAll" />
    <permission tools:node="removeAll" />
    <application android:name="android.app.Application" android:allowBackup="false"
        android:usesCleartextTraffic="false"
        tools:replace="android:name,android:allowBackup,android:usesCleartextTraffic"
        tools:remove="android:dataExtractionRules,android:fullBackupContent">
        <!-- Keep the debug Compose test-manifest's ComponentActivity, not MainActivity. -->
        <activity android:name="com.agrios.app.MainActivity" tools:node="remove" />
        <activity android:name="androidx.compose.ui.tooling.PreviewActivity" tools:node="remove" />
        <activity-alias tools:node="removeAll" />
        <service tools:node="removeAll" />
        <receiver tools:node="removeAll" />
        <provider tools:node="removeAll" />
    </application>
</manifest>
